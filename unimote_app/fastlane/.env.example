# Copy to fastlane/.env (git-ignored) and fill in. Keep key files outside the repository.

# --- iOS ---
# 10-character Team ID from developer.apple.com > Membership details
APPLE_TEAM_ID=
# App Store Connect > Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
# e.g. ~/.unimote-secrets/AuthKey_XXXXXXXXXX.p8
ASC_KEY_PATH=
# Private repository that stores the encrypted certificates and profiles
MATCH_GIT_URL=
# Passphrase that encrypts that repository
MATCH_PASSWORD=

# --- Android ---
# e.g. ~/.unimote-secrets/upload.jks
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Google Cloud service account JSON with access to the app in Play Console
PLAY_JSON_KEY_PATH=
# completed (default) or draft (required while the app has never been published)
PLAY_RELEASE_STATUS=
